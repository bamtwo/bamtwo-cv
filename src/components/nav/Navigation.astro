---
---

<nav
  id="site-nav"
  class="site-nav"
>
  <div class="nav-inner">
    <a href="#hero" class="nav-logo">@bamtwo</a>
    <div class="nav-links-desktop">
      <a href="#about">About</a>
      <a href="#experience">Experience</a>
      <a href="#skills">Skills</a>
      <a href="#projects">Projects</a>
      <a href="#lab">Lab</a>
      <a href="#education">Education</a>
      <a href="#speaking">Speaking</a>
      <a href="#contact">Contact</a>
    </div>
    <div class="nav-actions">
      <button
        class="theme-toggle-btn"
        data-theme-toggle
        aria-label="Toggle theme"
        data-interactive
      >
        <span class="toggle-icon toggle-icon-sun">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        </span>
        <span class="toggle-icon toggle-icon-moon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </span>
      </button>
      <button
        class="mobile-menu-btn"
        data-mobile-menu-toggle
        aria-label="Toggle menu"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>
  <div class="mobile-overlay" data-mobile-overlay>
    <div class="mobile-overlay-inner">
      <a href="#about" data-mobile-link>About</a>
      <a href="#experience" data-mobile-link>Experience</a>
      <a href="#skills" data-mobile-link>Skills</a>
      <a href="#projects" data-mobile-link>Projects</a>
      <a href="#lab" data-mobile-link>Lab</a>
      <a href="#education" data-mobile-link>Education</a>
      <a href="#speaking" data-mobile-link>Speaking</a>
      <a href="#contact" data-mobile-link>Contact</a>
    </div>
  </div>
  <div class="nav-active-indicator" data-active-indicator></div>
</nav>

<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-nav, 100);
    padding: var(--space-4) var(--space-6);
    transition: background-color 0.3s ease, backdrop-filter 0.3s ease;
  }

  .site-nav.scrolled {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border-bottom: 1px solid var(--glass-border);
  }

  .nav-inner {
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-logo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-wide);
    color: var(--accent-primary);
  }

  .nav-links-desktop {
    display: none;
    gap: var(--space-6);
  }

  .nav-links-desktop a {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    transition: color 0.2s ease;
    position: relative;
  }

  .nav-links-desktop a:hover {
    color: var(--accent-primary);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .theme-toggle-btn {
    background: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: var(--space-2);
    cursor: pointer;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.2s, background 0.2s;
  }

  .theme-toggle-btn:hover {
    border-color: var(--accent-primary);
    background: var(--glow-primary);
  }

  html[data-theme="dark"] .toggle-icon-moon { display: none; }
  html[data-theme="light"] .toggle-icon-sun { display: none; }

  .mobile-menu-btn {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-1);
  }

  .hamburger-line {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text-primary);
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .mobile-overlay {
    position: fixed;
    inset: 0;
    background: var(--base);
    z-index: 99;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .mobile-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-overlay-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
  }

  .mobile-overlay-inner a {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 700;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .nav-active-indicator {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--accent-primary);
    transition: width 0.3s ease, left 0.3s ease;
    width: 0;
  }

  @media (min-width: 768px) {
    .nav-links-desktop { display: flex; }
    .mobile-menu-btn { display: none; }
    .mobile-overlay { display: none; }
  }
</style>

<script>
  const nav = document.getElementById('site-nav')!;
  const overlay = document.querySelector('[data-mobile-overlay]')!;
  const menuBtn = document.querySelector('[data-mobile-menu-toggle]')!;
  const mobileLinks = document.querySelectorAll('[data-mobile-link]');

  let scrolled = false;
  window.addEventListener('scroll', () => {
    const isScrolled = window.scrollY > 50;
    if (isScrolled !== scrolled) {
      scrolled = isScrolled;
      nav.classList.toggle('scrolled', scrolled);
    }
  });

  menuBtn.addEventListener('click', () => {
    overlay.classList.toggle('open');
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      overlay.classList.remove('open');
    });
  });
</script>
