---
import ProjectCard from './ProjectCard.astro';

const projects = [
  { title: 'Eidolon Engine', description: 'Cross-platform game engine targeting embedded devices with custom ECS, Vulkan render pipeline, and mesh networking layer.', techStack: ['Rust', 'Vulkan', 'Lua', 'Nix'], gradient: 'linear-gradient(135deg, #0F2027, #203A43, #2C5364)' },
  { title: 'MorphoSDK', description: 'Open-source framework for L-system based parametric modeling. Used by research institutions for adaptive urban design in flood-prone regions.', techStack: ['Rust', 'Wasm', 'Three.js', 'PostGIS'], gradient: 'linear-gradient(135deg, #1a1a2e, #16213e, #0f3460)' },
  { title: 'Kairos Protocol', description: 'BFT consensus variant optimized for intermittent connectivity in mesh networks. Maintained consensus viability at 67% packet loss.', techStack: ['Go', 'libp2p', 'Noise Protocol'], gradient: 'linear-gradient(135deg, #0d0d0d, #1a0a2e, #2d1b69)' },
  { title: 'Pelagius Hydrophone Mesh', description: 'Distributed acoustic sensor array for deep-sea biodiversity monitoring. Processes 40TB/day with custom FFT pipelines and CNN anomaly detection.', techStack: ['Rust', 'Python', 'MQTT', 'Redis'], gradient: 'linear-gradient(135deg, #000428, #004e92, #2a5298)' },
  { title: 'Mycelium Memory', description: 'Award-winning art installation using generative fungal growth algorithms and spatialized audio. Exhibited at Ars Artificialis Biennial.', techStack: ['C++', 'OpenGL', 'SuperCollider', 'MIDI'], gradient: 'linear-gradient(135deg, #0b0b0b, #1b2a1b, #2d4a2d)' },
];
---

<section id="projects" class="projects-section section-container">
  <h2 class="section-title">Featured Projects</h2>
  <div class="projects-carousel" data-projects-carousel>
    <div class="projects-track" data-projects-track>
      {projects.map((project, i) => (
        <ProjectCard {...project} index={i + 1} />
      ))}
    </div>
  </div>
</section>

<style>
  .section-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 700;
    margin-bottom: var(--space-8);
  }

  .projects-carousel {
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: var(--space-4);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .projects-carousel::-webkit-scrollbar { display: none; }

  .projects-track {
    display: flex;
    padding: var(--space-2) 0;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reducedMotion) {
    const container = document.querySelector('[data-projects-carousel]');
    const track = document.querySelector('[data-projects-track]');
    if (container && track) {
      const extraWidth = track.scrollWidth - container.clientWidth;
      if (extraWidth > 0) {
        gsap.to(track, {
          x: -extraWidth,
          ease: 'none',
          scrollTrigger: {
            trigger: container,
            start: 'top top',
            end: `+=${extraWidth}`,
            pin: true,
            scrub: 0.8,
            anticipatePin: 1,
          },
        });
      }
    }
  }
</script>
